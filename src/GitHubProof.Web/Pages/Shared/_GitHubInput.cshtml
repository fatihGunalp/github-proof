@model GitHubInputModel

@*
    Session 138 live analysis progress (live-analysis-progress-runtime-contract.md,
    p10 §8.3.1–§8.3.6). Only this landing form carries a correlation token and
    receives polling; the Profile drill-down forms deliberately stay
    progress-free (§8, p10 §8.6.5). Both stage lists are rendered here,
    server-side, fully localized and in PENDING state, and stay hidden until the
    server reports which one applies — so every string is Web-owned and the
    transport carries no copy.
*@

@{
    (string stage, WebTextKey label)[] repositoryStages =
    {
        ("repository-target-validated", WebTextKey.ProgressRepositoryTargetValidated),
        ("repository-public-data-read", WebTextKey.ProgressRepositoryPublicDataRead),
        ("repository-traces-analyzed", WebTextKey.ProgressRepositoryTracesAnalyzed),
        ("repository-proof-prepared", WebTextKey.ProgressRepositoryProofPrepared)
    };

    (string stage, WebTextKey label)[] profileStages =
    {
        ("profile-target-validated", WebTextKey.ProgressProfileTargetValidated),
        ("profile-public-surface-read", WebTextKey.ProgressProfilePublicSurfaceRead),
        ("profile-evidence-examined", WebTextKey.ProgressProfileEvidenceExamined)
    };
}

<form
    class="repository-input"
    method="post"
    asp-page="/Index"
    data-analysis-form
    data-analysis-progress
    data-submitting="false"
    aria-busy="false">

    <label
        class="repository-input__label"
        for="github-target">
        @Text.Get(WebTextKey.InputLabel)
    </label>

    <div class="repository-input__control">
        <input
            class="input repository-input__field"
            id="github-target"
            name="GitHubTarget"
            type="text"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="none"
            value="@Model.GitHubTarget"
            placeholder="@Text.Get(WebTextKey.InputPlaceholder)"
            required
            aria-invalid="@(Model.HasError ? "true" : "false")"
            aria-describedby="@(Model.HasError ? "github-input-error" : null)" />

        <button
            class="button button--primary repository-input__action"
            type="submit"
            data-analysis-submit>
            <span>@Text.Get(WebTextKey.Analyze)</span>
            <span aria-hidden="true">→</span>
        </button>
    </div>

    @if (Model.HasError)
    {
        <p
            class="field__message field__message--error"
            id="github-input-error"
            role="alert">
            @Model.ErrorMessage
        </p>
    }

    <div
        class="analysis-progress"
        data-analysis-status
        hidden>

        @foreach (var (kind, stages) in new[]
        {
            ("repository", repositoryStages),
            ("profile", profileStages)
        })
        {
            <ol
                class="analysis-progress__stages"
                data-analysis-stages="@kind"
                hidden>
                @foreach (var (stage, label) in stages)
                {
                    <li
                        class="analysis-progress__stage"
                        data-stage="@stage"
                        data-state="pending">
                        <span class="analysis-progress__stage-glyph" aria-hidden="true"></span>
                        <span class="analysis-progress__stage-label">@Text.Get(label)</span>
                        <span class="analysis-progress__stage-state">
                            <span data-state-token="pending">@Text.Get(WebTextKey.ProgressStatePending)</span>
                            <span data-state-token="active">@Text.Get(WebTextKey.ProgressStateActive)</span>
                            <span data-state-token="completed">@Text.Get(WebTextKey.ProgressStateCompleted)</span>
                        </span>
                    </li>
                }
            </ol>
        }

        <span class="analysis-progress__indicator" aria-hidden="true"></span>

        @* The one polite, atomic live region. It carries exactly one sentence:
           the canonical indeterminate sentence until the first server snapshot,
           then the active stage label (p10 §8.3.5–§8.3.6). Narrowed to this
           child rather than removed — it keeps the three attributes it has
           today. *@
        <p
            class="analysis-progress__live"
            data-analysis-live
            role="status"
            aria-live="polite"
            aria-atomic="true">
            @Text.Get(WebTextKey.ProcessingRequest)
        </p>
    </div>
</form>
