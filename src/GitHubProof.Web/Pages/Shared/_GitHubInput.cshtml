@model GitHubInputModel

@*
    Session 138 live analysis progress (live-analysis-progress-runtime-contract.md,
    p10 §8.3.1–§8.3.6). Only this landing form carries a correlation token and
    receives polling; the Profile drill-down forms deliberately stay
    progress-free (§8, p10 §8.6.5). Both stage lists are rendered here,
    server-side, fully localized and in PENDING state, and stay hidden until the
    server reports which one applies — so every string is Web-owned and the
    transport carries no copy.
*@

@*
    Session 141 (contract 02): each stage carries one sentence per canonical
    state instead of one workflow-noun label plus a separate state token, so
    the copy describes the work being done and the state reads naturally in
    both languages. The stage identities, their order and the three runtime
    states are unchanged, and every sentence is still server-rendered and
    localized here — the transport still carries no copy.
*@
@{
    (string stage, WebTextKey pending, WebTextKey active, WebTextKey completed)[]
        repositoryStages =
    {
        ("repository-target-validated",
            WebTextKey.ProgressRepositoryTargetPending,
            WebTextKey.ProgressRepositoryTargetActive,
            WebTextKey.ProgressRepositoryTargetCompleted),
        ("repository-public-data-read",
            WebTextKey.ProgressRepositoryDataPending,
            WebTextKey.ProgressRepositoryDataActive,
            WebTextKey.ProgressRepositoryDataCompleted),
        ("repository-traces-analyzed",
            WebTextKey.ProgressRepositoryTracesPending,
            WebTextKey.ProgressRepositoryTracesActive,
            WebTextKey.ProgressRepositoryTracesCompleted),
        ("repository-proof-prepared",
            WebTextKey.ProgressRepositoryProofPending,
            WebTextKey.ProgressRepositoryProofActive,
            WebTextKey.ProgressRepositoryProofCompleted)
    };

    (string stage, WebTextKey pending, WebTextKey active, WebTextKey completed)[]
        profileStages =
    {
        ("profile-target-validated",
            WebTextKey.ProgressProfileTargetPending,
            WebTextKey.ProgressProfileTargetActive,
            WebTextKey.ProgressProfileTargetCompleted),
        ("profile-public-surface-read",
            WebTextKey.ProgressProfileRepositoriesPending,
            WebTextKey.ProgressProfileRepositoriesActive,
            WebTextKey.ProgressProfileRepositoriesCompleted),
        ("profile-evidence-examined",
            WebTextKey.ProgressProfileTracesPending,
            WebTextKey.ProgressProfileTracesActive,
            WebTextKey.ProgressProfileTracesCompleted)
    };
}

<form
    class="repository-input"
    method="post"
    asp-page="/Index"
    data-analysis-form
    data-analysis-progress
    data-submitting="false"
    aria-busy="false">

    <label
        class="repository-input__label"
        for="github-target">
        @Text.Get(WebTextKey.InputLabel)
    </label>

    <div class="repository-input__control">
        <input
            class="input repository-input__field"
            id="github-target"
            name="GitHubTarget"
            type="text"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
            autocapitalize="none"
            value="@Model.GitHubTarget"
            placeholder="@Text.Get(WebTextKey.InputPlaceholder)"
            required
            aria-invalid="@(Model.HasError ? "true" : "false")"
            aria-describedby="@(Model.HasError ? "github-input-error" : null)" />

        <button
            class="button button--primary repository-input__action"
            type="submit"
            data-analysis-submit>
            <span>@Text.Get(WebTextKey.Analyze)</span>
            <span aria-hidden="true">→</span>
        </button>
    </div>

    @if (Model.HasError)
    {
        <p
            class="field__message field__message--error"
            id="github-input-error"
            role="alert">
            @Model.ErrorMessage
        </p>
    }

    <div
        class="analysis-progress"
        data-analysis-status
        hidden>

        @foreach (var (kind, stages) in new[]
        {
            ("repository", repositoryStages),
            ("profile", profileStages)
        })
        {
            <ol
                class="analysis-progress__stages"
                data-analysis-stages="@kind"
                hidden>
                @foreach (var (stage, pending, active, completed) in stages)
                {
                    <li
                        class="analysis-progress__stage"
                        data-stage="@stage"
                        data-state="pending">
                        <span class="analysis-progress__stage-glyph" aria-hidden="true"></span>
                        <span class="analysis-progress__stage-label">
                            <span data-stage-label="pending">@Text.Get(pending)</span>
                            <span data-stage-label="active">@Text.Get(active)</span>
                            <span data-stage-label="completed">@Text.Get(completed)</span>
                        </span>
                    </li>
                }
            </ol>
        }

        <span class="analysis-progress__indicator" aria-hidden="true"></span>

        @* The one polite, atomic live region. It carries exactly one sentence:
           the canonical indeterminate sentence until the first server snapshot,
           then the active stage label (p10 §8.3.5–§8.3.6). Narrowed to this
           child rather than removed — it keeps the three attributes it has
           today. *@
        <p
            class="analysis-progress__live"
            data-analysis-live
            role="status"
            aria-live="polite"
            aria-atomic="true">
            @Text.Get(WebTextKey.ProcessingRequest)
        </p>
    </div>
</form>
