@using GitHubProof.Web.Presentation
@model StatusBadgeModel

@{
    StatusBadgePresentation badge =
        StatusBadgePresentation.From(Model.Status);
}

<span
    class="status-badge @badge.CssModifier"
    data-status="@Model.Status">
    <span class="status-badge__icon">
        @await Html.PartialAsync(
            "_StatusIcon",
            badge.Icon)
    </span>

    <span class="status-badge__label">
        @Model.StatusLabel
    </span>
</span>
