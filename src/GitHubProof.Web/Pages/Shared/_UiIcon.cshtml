@model UiIcon

<svg
    class="ui-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
    aria-hidden="true">
    @switch (Model)
    {
        case UiIcon.ChartPie:
            <path d="M21.21 15.89A10 10 0 1 1 8.11 2.99"></path>
            <path
                fill="currentColor"
                stroke="none"
                d="M12 2a10 10 0 0 1 10 10H12Z">
            </path>
            break;

        case UiIcon.ChartNoAxesColumnIncreasing:
            <path d="M5 21v-6"></path>
            <path d="M12 21V9"></path>
            <path d="M19 21V3"></path>
            break;

        case UiIcon.ListTree:
            <path d="M8 5h13"></path>
            <path d="M13 12h8"></path>
            <path d="M13 19h8"></path>
            <path d="M3 10a2 2 0 0 0 2 2h3"></path>
            <path d="M3 5v12a2 2 0 0 0 2 2h3"></path>
            break;

        case UiIcon.FolderGit2:
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
            <circle cx="9" cy="13" r="1.5"></circle>
            <circle cx="15" cy="13" r="1.5"></circle>
            <path d="M10.5 13h3"></path>
            break;

        case UiIcon.Github:
            <path
                fill="currentColor"
                stroke="none"
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.19-.02-2.16-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18A11 11 0 0 1 12 6.03a11 11 0 0 1 2.89.39c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z">
            </path>
            break;

        case UiIcon.Link2:
            <path d="M9 17H7A5 5 0 0 1 7 7h2"></path>
            <path d="M15 7h2a5 5 0 1 1 0 10h-2"></path>
            <path d="M8 12h8"></path>
            break;

        case UiIcon.Code2:
            <path d="m16 18 6-6-6-6"></path>
            <path d="m8 6-6 6 6 6"></path>
            break;

        case UiIcon.GitBranch:
            <line x1="6" x2="6" y1="3" y2="15"></line>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 0 1-9 9"></path>
            break;

        case UiIcon.ExternalLink:
            <path d="M15 3h6v6"></path>
            <path d="M10 14 21 3"></path>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            break;

        case UiIcon.Clock:
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
            break;

        case UiIcon.Info:
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
            break;

        case UiIcon.ChevronRight:
            <path d="m9 18 6-6-6-6"></path>
            break;

        case UiIcon.Sparkles:
            <path d="m12 3-1.45 5.55L5 10l5.55 1.45L12 17l1.45-5.55L19 10l-5.55-1.45Z"></path>
            <path d="m19 16-.7 2.3L16 19l2.3.7L19 22l.7-2.3L22 19l-2.3-.7Z"></path>
            <path d="m5 2-.45 1.55L3 4l1.55.45L5 6l.45-1.55L7 4l-1.55-.45Z"></path>
            break;

        case UiIcon.Layers3:
            <path d="m12 2 9 5-9 5-9-5 9-5Z"></path>
            <path d="m3 12 9 5 9-5"></path>
            <path d="m3 17 9 5 9-5"></path>
            break;

        case UiIcon.Compass:
            <circle cx="12" cy="12" r="9"></circle>
            <path d="m15.5 8.5-2.4 4.8-4.6 2.2 2.4-4.8 4.6-2.2Z"></path>
            break;

        case UiIcon.Search:
            <circle cx="11" cy="11" r="6"></circle>
            <path d="m20 20-4.35-4.35"></path>
            break;

        case UiIcon.ChartColumnOff:
            <path d="M5 21v-4"></path>
            <path d="M12 21v-7"></path>
            <path d="M19 21V8"></path>
            <path d="m4 4 16 16"></path>
            break;

        case UiIcon.ChevronsUpOff:
            <path d="m7 13 5-4 5 4"></path>
            <path d="m7 19 5-4 5 4"></path>
            <path d="m4 4 16 16"></path>
            break;

        case UiIcon.SparklesOff:
            <path d="M12 4.5 13.6 9l4.4 1.6-4.4 1.6L12 16.6l-1.6-4.4L6 10.6 10.4 9Z"></path>
            <path d="m4 4 16 16"></path>
            break;

        case UiIcon.CircleCheckOff:
            <circle cx="12" cy="12" r="8.5"></circle>
            <path d="m8.5 12 2.5 2.5 4.5-5"></path>
            <path d="m4 4 16 16"></path>
            break;

        default:
            throw new InvalidOperationException(
                $"Unsupported UI icon: {Model}");
    }
</svg>
