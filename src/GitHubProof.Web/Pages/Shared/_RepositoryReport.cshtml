@model RepositoryReport

@{
    bool canonicalOrder =
        Model.SectionOrder.SequenceEqual(
            RepositoryReportSectionKeys.CanonicalOrder,
            StringComparer.Ordinal);

    if (!canonicalOrder)
    {
        throw new InvalidOperationException(
            "RepositoryReport section order is not canonical.");
    }
}

<article
    class="report"
    data-report-locale="@Model.Locale">

    <section
        class="report-section report-identity"
        data-report-section="@RepositoryReportSectionKeys.Identity">

        @await Html.PartialAsync(
            "_RepositoryReportIdentity",
            Model)
    </section>

    <div class="report-first-reading report-decision-grid">
        <div
            class="report-summary-card report-summary-card--score"
            aria-label="@Model.ScoreSummary.SectionTitle">

            @await Html.PartialAsync(
                "_RepositoryReportScoreCard",
                Model)
        </div>

        <section
            class="report-section report-section--first-reading report-summary-card report-summary-card--strength"
            data-report-section="@RepositoryReportSectionKeys.Proves">

            @await Html.PartialAsync(
                "_RepositoryReportProves",
                Model)
        </section>

        <section
            class="report-section report-section--first-reading report-summary-card report-summary-card--weakness"
            data-report-section="@RepositoryReportSectionKeys.Weakens">

            @await Html.PartialAsync(
                "_RepositoryReportWeakens",
                Model)
        </section>

        <section
            class="report-section report-section--decision report-section--first-reading report-summary-card report-summary-card--action"
            data-report-section="@RepositoryReportSectionKeys.DoFirst">

            @await Html.PartialAsync(
                "_RepositoryReportActions",
                Model)
        </section>
    </div>

    @if (
        Model.Uncertainty.Items.Count > 0
        || Model.Warnings.Count > 0
        || Model.Limitations.Count > 0)
    {
        <section
            class="report-section report-section--uncertainty"
            data-report-section="@RepositoryReportSectionKeys.Uncertainty">

            @await Html.PartialAsync(
                "_RepositoryReportUncertainty",
                Model)
        </section>
    }

    <section
        class="report-section report-score report-layer"
        data-report-section="@RepositoryReportSectionKeys.CategoriesAndScore">

        @await Html.PartialAsync(
            "_RepositoryReportScore",
            Model)
    </section>

    <section
        class="report-section"
        data-report-section="@RepositoryReportSectionKeys.SignalDetails">

        @await Html.PartialAsync(
            "_RepositoryReportSignals",
            Model)
    </section>

    <section
        class="report-section report-disclaimer report-layer"
        data-report-section="@RepositoryReportSectionKeys.Disclaimer">

        @await Html.PartialAsync(
            "_RepositoryReportDisclaimer",
            Model)
    </section>
</article>
