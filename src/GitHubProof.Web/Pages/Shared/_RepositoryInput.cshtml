<div class="repository-input">
    <label class="repository-input__label" for="repository-url">
        Public GitHub repository URL
    </label>

    <div class="repository-input__control">
        <input
            class="input repository-input__field"
            id="repository-url"
            name="repositoryUrl"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="https://github.com/owner/repository"
            aria-describedby="repository-input-context" />

        <button
            class="button button--primary repository-input__action"
            type="button"
            disabled>
            <span>Analyze</span>
            <span aria-hidden="true">→</span>
        </button>
    </div>

    <div class="repository-input__context" id="repository-input-context">
        <span>Public repositories only</span>
        <span class="repository-input__separator" aria-hidden="true">·</span>
        <span>15 deterministic signals</span>
        <span class="repository-input__separator" aria-hidden="true">·</span>
        <span>No developer judgment</span>
    </div>
</div>