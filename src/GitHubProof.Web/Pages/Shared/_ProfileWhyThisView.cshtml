@model ProfileReportSection<ConclusionEvidenceReportItem>

@*
    P10-I4 Why layer. Items are exactly the same canonical conclusions already
    rendered by TechnicalFocusAreas/EngineeringPracticePatterns. Web translates
    each existing trace into a visitor question, a bounded reason and the same
    supporting public repository identities — never a new claim
    (presentation-language-contract.md §8.6.3). No count, rule/observation
    version, observation key, analysis identifier, SupportingEvidence/
    EvidenceKey/EvidenceKeys, score/ranking/capability language.
*@
@{
    if (Model.SectionKey != ProfileReportSectionKey.WhyThisConclusion
        || Model.Availability != ProfileReportSectionAvailability.Supported)
    {
        throw new InvalidOperationException(
            "Why partial requires a Supported WhyThisConclusion section, but "
            + $"received '{Model.SectionKey}' / '{Model.Availability}'.");
    }
}

@if (Model.Items.Count > 0)
{
    <details class="profile-result__section profile-result__section--why">
        <summary class="profile-result__disclosure-summary">
            <span class="profile-result__icon-tile" aria-hidden="true">
                @await Html.PartialAsync("_UiIcon", UiIcon.Search)
            </span>

            <span class="profile-result__disclosure-copy">
                <h2 class="profile-result__section-title">
                    @ProfileText.GetSectionLabel(Model.SectionKey, Text.Culture)
                </h2>
                <span class="profile-result__disclosure-description">
                    @ProfileText.GetWhyDisclosureDescription(Text.Culture)
                </span>
            </span>

            <span class="profile-result__disclosure-chevron" aria-hidden="true">
                @await Html.PartialAsync("_UiIcon", UiIcon.ChevronRight)
            </span>
        </summary>

        <div class="profile-result__disclosure-body">
            @foreach (ConclusionEvidenceReportItem item in Model.Items)
            {
                <div class="profile-result__why-entry">
                    <h3 class="profile-result__why-entry-title">
                        @ProfileText.GetWhyEntryQuestion(
                            item.Pattern.Family,
                            item.Pattern.PatternKey,
                            Text.Culture)
                    </h3>

                    <p class="profile-result__why-explanation">
                        @ProfileText.GetWhyExplanation(
                            item.Pattern.Family,
                            item.Pattern.PatternKey,
                            Text.Culture)
                    </p>

                    <p class="profile-result__lead-in">
                        @ProfileText.GetWhySupportingRepositoriesLeadIn(Text.Culture)
                    </p>

                    <ul class="profile-result__repository-list">
                        @foreach (var repository in item.Pattern.SupportingRepositories)
                        {
                            <li class="profile-result__repository-item">
                                @repository.FullName
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </details>
}
else
{
    <section
        class="profile-result__section profile-result__section--why"
        aria-labelledby="profile-why-title">

        <div class="profile-result__card-heading">
            <span class="profile-result__icon-tile" aria-hidden="true">
                @await Html.PartialAsync("_UiIcon", UiIcon.Search)
            </span>

            <h2
                class="profile-result__section-title"
                id="profile-why-title">
                @ProfileText.GetSectionLabel(Model.SectionKey, Text.Culture)
            </h2>
        </div>

        <p class="profile-result__section-empty">
            @ProfileText.GetEmptySectionMessage(Model.SectionKey, Text.Culture)
        </p>
    </section>
}
