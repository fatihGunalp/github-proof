@page
@model ProfileModel

@{
    ViewData["Title"] = Text.Get(WebTextKey.ProfileView);
}

@*
    P10-I3 result boundary, rendered from the POST handler. Renders the
    already-projected typed ProfileReport in canonical experience order:
    Meaning -> Visible technical direction -> Recurring engineering practices
    -> Starting point. WhyThisConclusion + evidence drill-down is P10-I4;
    final Limitations/Warnings/Partial/Failure UX is P10-I5 — neither is
    rendered here.
*@
<section
    class="profile-result"
    aria-labelledby="profile-result-title">

    <h1
        class="profile-result__title"
        id="profile-result-title">
        @Text.Get(WebTextKey.ProfileView)
    </h1>

    <p class="profile-result__identity">
        @Model.Identity
    </p>

    @if (Model.ErrorMessage is not null)
    {
        <p
            class="field__message field__message--error"
            role="alert">
            @Model.ErrorMessage
        </p>
    }
    else if (Model.Report is { } report)
    {
        @await Html.PartialAsync(
            "_ProfileMeaning",
            report.PublicProfileSummary.Items)

        @await Html.PartialAsync(
            "_ProfilePatternSection",
            report.TechnicalFocusAreas)

        @await Html.PartialAsync(
            "_ProfilePatternSection",
            report.EngineeringPracticePatterns)

        @await Html.PartialAsync(
            "_ProfileStartingPoint",
            report.RepresentativeRepositories)
    }

    <a
        class="profile-result__back"
        href="/">
        <span aria-hidden="true">←</span> @Text.Get(WebTextKey.AnalyzeSomethingElse)
    </a>
</section>
