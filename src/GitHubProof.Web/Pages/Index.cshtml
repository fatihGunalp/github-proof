@page
@model IndexModel

@{
    ViewData["Title"] = "GitHub Proof";
}

@if (Model.Report is null)
{
    <section
        class="home"
        aria-labelledby="home-title">

        <div class="home__content">
            <h1
                class="home__title"
                id="home-title">
                See what your GitHub communicates.
            </h1>

            <p class="home__summary">
                Public evidence. Clear direction. No guesses.
            </p>

            <partial
                name="_GitHubInput"
                model="@(new GitHubInputModel(
                    Model.GitHubTarget,
                    Model.ErrorMessage))" />
        </div>

        <div class="boundaries">
            <h2
                class="boundaries__title"
                id="boundaries-title">
                What GitHub Proof is not
            </h2>

            <div class="boundaries__grid">
                <div class="boundaries__item">
                    <span class="boundaries__item-icon">
                        <partial
                            name="_UiIcon"
                            model="UiIcon.ChartColumnOff" />
                    </span>
                    <p class="boundaries__item-title">No developer ranking</p>
                    <p class="boundaries__item-description">
                        We don't rank or score developers.
                    </p>
                </div>

                <div class="boundaries__item">
                    <span class="boundaries__item-icon">
                        <partial
                            name="_UiIcon"
                            model="UiIcon.ChevronsUpOff" />
                    </span>
                    <p class="boundaries__item-title">No seniority judgment</p>
                    <p class="boundaries__item-description">
                        We don't judge experience or seniority.
                    </p>
                </div>

                <div class="boundaries__item">
                    <span class="boundaries__item-icon">
                        <partial
                            name="_UiIcon"
                            model="UiIcon.SparklesOff" />
                    </span>
                    <p class="boundaries__item-title">No AI authorship claims</p>
                    <p class="boundaries__item-description">
                        We don't guess or claim AI authorship.
                    </p>
                </div>

                <div class="boundaries__item">
                    <span class="boundaries__item-icon">
                        <partial
                            name="_UiIcon"
                            model="UiIcon.CircleCheckOff" />
                    </span>
                    <p class="boundaries__item-title">No hire/no-hire verdict</p>
                    <p class="boundaries__item-description">
                        We don't tell you who to hire or not.
                    </p>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <partial
        name="_RepositoryReport"
        model="Model.Report" />
}
