@page
@model IndexModel

@{
    ViewData["Title"] = "GitHub Proof";
}

@if (Model.Report is null)
{
    <section
        class="home"
        aria-labelledby="home-title">

        <div class="home__content">
            <h1
                class="home__title"
                id="home-title">
                @Text.Get(WebTextKey.LandingTitle)
            </h1>

            <p class="home__summary">
                @Text.Get(WebTextKey.LandingSummary)
            </p>

            <partial
                name="_GitHubInput"
                model="@(new GitHubInputModel(
                    Model.GitHubTarget,
                    Model.ErrorMessage))" />
        </div>

        <details class="boundaries">
            <summary class="boundaries__summary">
                <span class="boundaries__summary-text">
                    @Text.Get(WebTextKey.BoundariesSummary)
                </span>
                <span class="boundaries__disclosure-label">
                    @Text.Get(WebTextKey.BoundariesDisclosureLabel)
                </span>
            </summary>

            <ul class="boundaries__list">
                <li>@Text.Get(WebTextKey.NoDeveloperRankingTitle)</li>
                <li>@Text.Get(WebTextKey.NoSeniorityTitle)</li>
                <li>@Text.Get(WebTextKey.NoAiAuthorshipTitle)</li>
                <li>@Text.Get(WebTextKey.NoHireVerdictTitle)</li>
            </ul>
        </details>
    </section>
}
else
{
    <partial
        name="_RepositoryReport"
        model="Model.Report" />
}
